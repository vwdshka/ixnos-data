# Copy to .env for local development. Never commit .env.
# Every ixnos-data setting uses the IXNOS_DATA_ prefix.

# PostgreSQL (compose.yaml). Host port 5433 so it never clashes with a locally installed Postgres on 5432.
IXNOS_DATA_DB_NAME=ixnos_data
IXNOS_DATA_DB_USER=ixnos_data
IXNOS_DATA_DB_PASSWORD=ixnos_data
IXNOS_DATA_DB_PORT=5433

# Host ports for the API and web app
IXNOS_DATA_API_PORT=8080
IXNOS_DATA_WEB_PORT=3000

# .NET API when run natively (dotnet run); "__" is the .NET config section separator
IXNOS_DATA_ConnectionStrings__IxnosData=Host=localhost;Port=5433;Database=ixnos_data;Username=ixnos_data;Password=ixnos_data

# Pipeline when run natively (uv run)
IXNOS_DATA_DATABASE_URL=postgresql+psycopg://ixnos_data:ixnos_data@localhost:5433/ixnos_data
IXNOS_DATA_KHMDHS_MIN_INTERVAL_SECONDS=4
# IXNOS_DATA_RAW_CACHE_DIR=../.data/raw

# Web app: where server-side code reaches the API
IXNOS_DATA_API_URL=http://localhost:8080
# Public origin for sitemaps and link previews (production: https://<domain>)
IXNOS_DATA_SITE_URL=http://localhost:3000

# Email (sign-in links, alert digests). Without an SMTP host, emails are written as .eml files
# to IXNOS_DATA_Email__PickupDirectory (default: <temp>/ixnos-data-mail) for development.
IXNOS_DATA_Web__BaseUrl=http://localhost:3000

# Error tracking (optional): a Sentry DSN for each service. Unset means off.
# IXNOS_DATA_Sentry__Dsn=          (API and notifier)
# IXNOS_DATA_SENTRY_DSN=           (web app)

# Production only (infra/compose.prod.yaml)
# IXNOS_DATA_SMTP_HOST=smtp.provider.example
# IXNOS_DATA_SMTP_USERNAME=
# IXNOS_DATA_SMTP_PASSWORD=
# IXNOS_DATA_EMAIL_FROM=ixnos-data <no-reply@ixnos-data.example>
# IXNOS_DATA_DOMAIN=ixnos-data.example
# IXNOS_DATA_IMAGE_PREFIX=ghcr.io/vwdshka/ixnos-data
# IXNOS_DATA_TAG=latest
