<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>0.1.0</Version>
    <PackageId>IxnosData.Client</PackageId>
    <Authors>David Gavriilidis</Authors>
    <Description>Client for the ixnos-data API: Greek public procurement (ΚΗΜΔΗΣ) and spending (Διαύγεια) records.</Description>
    <PackageTags>greece;procurement;open-data;khmdhs;diavgeia</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/vwdshka/ixnos-data</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
